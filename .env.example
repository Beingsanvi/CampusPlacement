# ==========================================================================
# Campus Placement AI - Environment Configuration (copy to backend/.env)
# ==========================================================================
# Never commit real secrets. The real .env file is gitignored.

# --- Microsoft Foundry / Azure OpenAI-compatible endpoint ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-id>
FOUNDRY_API_KEY=<your-foundry-api-key>
MODEL_DEPLOYMENT_NAME=<deployed-model-name>
# Optional override if the auto-derived OpenAI host is wrong:
# FOUNDRY_OPENAI_BASE_URL=https://<your-resource>.openai.azure.com

# --- Azure AI Search (RAG) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-key>
AZURE_SEARCH_INDEX_NAME=placement-documents

# --- Job scraping sources (optional limits) ---
JOBS_CACHE_TTL_SECONDS=3600
JOBS_MAX_PER_SOURCE=50

# --- SMTP (cold email sending - use an app password, NOT your real password) ---
SMTP_HOST=<smtp.gmail.com or smtp.office365.com>
SMTP_PORT=587
SMTP_USERNAME=<your-email@example.com>
SMTP_PASSWORD=<your-smtp-app-password>
EMAIL_FROM=<your-email@example.com>
EMAIL_FROM_NAME=<Your Full Name>

# --- Storage ---
# DATA_DIR=backend/data